{
  "name": "@onboardflow/sdk",
  "version": "0.1.0",
  "description": "OnboardFlow tracking and tour-rendering SDK",
  "type": "module",
  "main": "./dist/onboardflow.cjs.js",
  "module": "./dist/onboardflow.es.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/onboardflow.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/onboardflow.es.js",
      "require": "./dist/onboardflow.cjs.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b --noEmit && vite build && vite build --config vite.config.cdn.ts",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^4.4.0"
  }
}
